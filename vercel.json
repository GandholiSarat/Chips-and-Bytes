{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd Frontend && npm ci",
  "buildCommand": "cd Frontend && npm run build",
  "outputDirectory": "Frontend/build",
  "rewrites": [
    { "source": "/blogs", "destination": "/index.html" },
    { "source": "/blogs/:path*", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/projects/:path*", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/events/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
